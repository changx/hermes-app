# Secrets and private data
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.mobileprovision

# Project-local temporary files (shared repository/workspace root)
/tmp/

# Dependencies/build outputs
node_modules/
# Also ignore task-local symlink to retained dependencies
node_modules
.venv/
__pycache__/
*.pyc
dist/
build/
coverage/
.expo/
.expo-shared/
apps/mobile/src/markdownRenderer.generated.ts
apps/desktop/.package-staging/
apps/desktop/artifacts/
.DS_Store
# Expo native projects are generated (expo prebuild); keep them out of git and out of the update fingerprint
apps/mobile/ios/
apps/mobile/android/
# Public code signing certificate for mobile updates (the private key stays in the private workspace)
!apps/mobile/certs/certificate.pem
