{
  "name": "hermes-app-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "postinstall": "node scripts/build-markdown-renderer.mjs",
    "build:markdown-renderer": "node scripts/build-markdown-renderer.mjs",
    "start": "expo start",
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "export:android": "expo export --platform android --output-dir dist/android --no-bytecode --max-workers 2",
    "export:ios": "expo export --platform ios --output-dir dist/ios --no-bytecode --max-workers 2"
  },
  "dependencies": {
    "@react-native-community/netinfo": "12.0.1",
    "base64-js": "^1.5.1",
    "esbuild": "0.28.1",
    "expo": "58.0.22",
    "expo-alternate-app-icons": "8.0.0",
    "expo-blur": "~58.0.5",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.14",
    "expo-crypto": "~58.0.7",
    "expo-dev-client": "~58.0.18",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.11",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.15",
    "expo-router": "~58.0.29",
    "expo-secure-store": "~58.0.2",
    "expo-status-bar": "~58.0.4",
    "expo-symbols": "~58.0.4",
    "expo-video": "~58.0.13",
    "expo-web-browser": "~58.0.7",
    "katex": "0.18.9",
    "markdown-it": "14.3.2",
    "mermaid": "11.17.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-keyboard-controller": "1.22.7",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.1",
    "react-native-webview": "14.0.1",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@types/markdown-it": "14.1.2",
    "@types/react": "~19.3.0",
    "react-test-renderer": "19.3.0",
    "typescript": "~6.0.3"
  }
}
