{
  "name": "hermes-app-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "postinstall": "node scripts/build-markdown-renderer.mjs",
    "build:markdown-renderer": "node scripts/build-markdown-renderer.mjs",
    "start": "expo start",
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "export:android": "expo export --platform android --output-dir dist/android --no-bytecode --max-workers 2",
    "export:ios": "expo export --platform ios --output-dir dist/ios --no-bytecode --max-workers 2"
  },
  "dependencies": {
    "@react-native-community/netinfo": "12.0.1",
    "base64-js": "^1.5.1",
    "esbuild": "0.28.1",
    "expo": "57.0.25",
    "expo-alternate-app-icons": "8.0.0",
    "expo-blur": "~57.0.3",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.19",
    "expo-crypto": "~57.0.3",
    "expo-dev-client": "~57.0.20",
    "expo-document-picker": "~57.0.2",
    "expo-file-system": "~57.0.7",
    "expo-font": "57.0.4",
    "expo-image-picker": "~57.0.20",
    "expo-linking": "~57.0.11",
    "expo-router": "~57.0.23",
    "expo-secure-store": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-video": "57.0.5",
    "expo-web-browser": "~57.0.3",
    "katex": "0.18.9",
    "markdown-it": "14.3.2",
    "mermaid": "11.17.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-keyboard-controller": "1.21.9",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/markdown-it": "14.1.2",
    "@types/react": "~19.2.4",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3"
  }
}
