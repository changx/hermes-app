{
  "name": "hermes-app-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "export:android": "expo export --platform android --output-dir dist/android --no-bytecode --max-workers 2",
    "export:ios": "expo export --platform ios --output-dir dist/ios --no-bytecode --max-workers 2"
  },
  "dependencies": {
    "expo": "57.0.25",
    "expo-crypto": "~57.0.3",
    "expo-secure-store": "~57.0.4",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.4",
    "typescript": "~6.0.3"
  }
}
