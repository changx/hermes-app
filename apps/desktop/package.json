{
  "name": "@hermes-app/desktop",
  "version": "0.1.49",
  "private": true,
  "description": "Hermes App desktop client for macOS",
  "main": "dist/main/index.cjs",
  "scripts": {
    "build": "node build.mjs",
    "package:mac": "npm run build && node package.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run typecheck && npm run build && npm test",
    "start": "electron ."
  },
  "dependencies": {
    "@hermes-app/client": "0.1.0",
    "katex": "0.18.10",
    "mermaid": "11.17.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-markdown": "10.1.0",
    "rehype-katex": "7.0.1",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "@types/node": "22.20.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/ws": "8.18.1",
    "electron": "44.4.5",
    "esbuild": "0.28.1",
    "typescript": "6.0.3"
  }
}
